{
  "manifest_version": 3,
  "name": "ZDF Subtitle Lab",
  "version": "0.1.3",
  "description": "Independent lab extension for testing ZDF VOD and Live subtitle acquisition.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.zdf.de/*",
    "https://api.zdf.de/*",
    "https://utstreaming.zdf.de/*",
    "https://*.akamaized.net/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.zdf.de/*"],
      "js": ["zdf-page-bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.zdf.de/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "ZDF Subtitle Lab"
  }
}
