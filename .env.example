GLE_TRANSLATION_URL=http://translation:5000
LT_LOAD_ONLY=de,en,tr
CORS_ORIGINS=http://localhost:3001,http://localhost:5173
CORS_ORIGIN_REGEX=^https://(www\.)?youtube\.com$|^https://([^.]+\.)?zdf\.de$|^https://([^.]+\.)?ardmediathek\.de$|^chrome-extension://.*$
VITE_API_BASE_URL=http://localhost:8000

